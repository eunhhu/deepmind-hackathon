{
  "name": "deepmind-argon-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev:web": "bun --filter @deepmind/web dev",
    "dev:api": "cd apps/api && go run ./cmd/server",
    "check": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "test:api": "cd apps/api && go test -v -race ./...",
    "test:all": "bun --filter '*' test && cd apps/api && go test -race ./...",
    "test:e2e": "bunx playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "typescript": "^5.8.0"
  }
}
